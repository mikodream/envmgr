/dist/
/envmgr
/envmgr.exe

# Offline snapshots produced by cmd/snap. These ARE committed: the README embeds
# them, so the screenshots have to travel with the source.
# /shots/

# Local reference material: the mygo source copy
/_probe/

# Editor and OS noise
.DS_Store
Thumbs.db
*.log

# Workspace notes kept by the agent, not part of the program
/.workbuddy/
